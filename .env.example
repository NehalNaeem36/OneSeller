# ---------- Backend (FastAPI) ----------
# SQLite for local dev; PostgreSQL (Neon/Supabase) in production, e.g.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./oneseller.db
# Neon: DATABASE_URL = pooled (-pooler) host for the app; DATABASE_URL_UNPOOLED = direct host for migrations + agent checkpointer
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# LLM provider: ollama (local Qwen, free) | anthropic (claude-haiku-5-5, paid)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_MAX_OUTPUT_TOKENS=500
# Hard spending cap for paid LLM calls, in USD (enforced from the usage_log table)
LLM_BUDGET_USD=0.90

# Commerce (PKR)
STANDARD_PRICE=2500
STANDARD_ORDER_LIMIT=300
PREMIUM_PRICE=6000
PREMIUM_ORDER_LIMIT=2000
TRIAL_ORDER_LIMIT=50
ALLOW_BILLING_SIMULATION=true
PUBLIC_API_ORDERS_AFFECT_INVENTORY=false

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
